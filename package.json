{
  "name": "gayer",
  "version": "1.0.4",
  "description": "Pretty audio and music player with support for custom playlists, cover art fetching, playlist import/export, and more",
  "main": "./out/main/index.js",
  "author": "esteakacrownie",
  "license": "GPL-3.0-only",
  "url": "https://github.com/esteakacrownie/gayer",
  "homepage": "https://github.com/esteakacrownie/gayer",
  "desktopName": "com.integraxseras.Gayer",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm ci && npm run build && electron-builder --dir",
    "build:win": "npm ci && npm run build && electron-builder --win",
    "build:mac": "npm ci && npm run build && electron-builder --mac",
    "build:linux": "npm ci && npm run build && electron-builder --linux",
    "build:release": "npm ci && npm run build && electron-builder --linux --win"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@sglara/cn": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "album-art": "^4.0.4",
    "electron-settings": "^4.0.4",
    "electron-updater": "^6.3.9",
    "motion": "^13.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0",
    "truncate-utf8-bytes": "^1.0.2",
    "ytdlp-nodejs": "^3.4.5",
    "ytmusic-api": "^5.3.1",
    "zustic": "^1.2.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "appdirsjs": "^1.2.8",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.2.6"
  },
  "keywords": [
    "gleamy",
    "audio",
    "music",
    "player",
    "playlist",
    "album",
    "song"
  ]
}
